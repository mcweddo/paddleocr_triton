# Triton Server Configuration for Memory-Constrained Deployment
# Place this file in the same directory as model_repository or specify with --model-control-mode

rate_limiter {
  resource [
    {
      name: "gpu_memory"
      count: 2
    }
  ]
}

backend_config {
  name: "onnxruntime"
  setting {
    key: "memory_limit_mb"
    value: "12288"  #12GB limit for ONNX/TensorRT combined
  }
}

backend_config {
  name: "python"
  setting {
    key: "shm-default-byte-size"
    value: "1048576000"  #1GB
  }
}

model_control_mode: MODE_EXPLICIT

response_cache {
  enable: true
  byte_size: 268435456  #256MB
}
