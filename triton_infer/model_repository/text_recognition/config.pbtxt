name: "text_recognition"
backend: "onnxruntime"
max_batch_size : 0

input [
  {
    name: "x"
    data_type: TYPE_FP32
    dims: [ -1, 3, 48, -1 ]
  }
]
output [
  {
    name: "fetch_name_0"
    data_type: TYPE_FP32
    dims: [ -1, -1, 504 ]
  }
]

# Dynamic batching disabled: model handles batching internally via 4D input [batch,C,H,W]
# Batching happens in the preprocessing step which stacks multiple crops together

instance_group [
    {
      count: 4
      kind: KIND_GPU
    }
]

# ONNX Runtime optimizations (CUDA Execution Provider - no TensorRT)
# Using CUDA EP for simpler deployment and predictable memory usage

# ONNX Runtime session parameters
parameters { key: "execution_mode"        value: { string_value: "1" } }  # 1=Parallel execution

# Thread counts: Minimal for GPU inference
parameters { key: "intra_op_thread_count" value: { string_value: "1" } }
parameters { key: "inter_op_thread_count" value: { string_value: "1" } }

# Memory management
parameters { key: "arena_extend_strategy" value: { string_value: "1" } }  # kSameAsRequested (precise allocation)
parameters { key: "gpu_mem_limit"         value: { string_value: "3221225472" } }  # 3GB limit (conservative)

# CUDA Execution Provider specific settings
parameters { key: "cudnn_conv_algo_search" value: { string_value: "DEFAULT" } }  # Balance speed/memory
parameters { key: "do_copy_in_default_stream" value: { string_value: "1" } }  # Better multi-instance perf

# Graph optimization level
parameters { key: "graph_optimization_level" value: { string_value: "2" } }  # Extended optimizations

# Enable memory pattern optimization
parameters { key: "enable_mem_pattern" value: { string_value: "1" } }

# CPU memory arena
parameters { key: "enable_cpu_mem_arena" value: { string_value: "1" } }

# Reduced warmup iterations to save memory during startup
model_warmup [
  {
    name: "warm_batch16_w320"
    count: 1
    inputs {
      key: "x"
      value: {
        data_type: TYPE_FP32
        dims: [ 16, 3, 48, 320 ]
        zero_data: true
      }
    }
  },
  {
    name: "warm_batch8_w160"
    count: 1
    inputs {
      key: "x"
      value: {
        data_type: TYPE_FP32
        dims: [ 8, 3, 48, 160 ]
        zero_data: true
      }
    }
  },
  {
    name: "warm_batch32_w480"
    count: 1
    inputs {
      key: "x"
      value: {
        data_type: TYPE_FP32
        dims: [ 32, 3, 48, 480 ]
        zero_data: true
      }
    }
  }
]
