name: "text_recognition"
backend: "onnxruntime"
max_batch_size : 64

# Enable dynamic batching to batch text crops together and reduce TensorRT kernel warmups
dynamic_batching {
  preferred_batch_size: [ 8, 16, 32 ]
  max_queue_delay_microseconds: 8000
}

instance_group [
    {
      count: 2
      kind: KIND_GPU
    }
]

optimization {
  execution_accelerators {
    gpu_execution_accelerator: [{
      name: "tensorrt"
      parameters { key: "precision_mode" value: "FP16" }
      parameters { key: "trt_engine_cache_enable" value: "1" }
      parameters { key: "trt_engine_cache_path"   value: "/workspace/models/_trt_cache/text_recognition" }
      parameters { key: "trt_cuda_graph_enable"   value: "0"}
      # Reduced from 4GB to 1.5GB for memory-constrained deployment
      parameters { key: "max_workspace_size_bytes" value: "1610612736"}
      # Optimization profiles for width dimension
      # With max_batch_size>0, batch is NOT in dims, so profile is 3D: CxHxW
      parameters { key: "trt_profile_min_shapes" value: "x:3x48x32" }
      parameters { key: "trt_profile_opt_shapes" value: "x:3x48x320" }
      parameters { key: "trt_profile_max_shapes" value: "x:3x48x960" }
    }]
  }
}

# ONNX Runtime session parameters
parameters { key: "execution_mode"        value: { string_value: "1" } }  # 1=Parallel execution

# Thread counts: Set to 1 for GPU models since compute happens on GPU, not CPU
# This reduces CPU overhead and memory usage
parameters { key: "intra_op_thread_count" value: { string_value: "1" } }
parameters { key: "inter_op_thread_count" value: { string_value: "1" } }

# Memory management
parameters { key: "arena_extend_strategy" value: { string_value: "1" } }  # 1=kSameAsRequested (grow as needed)
parameters { key: "gpu_mem_limit"         value: { string_value: "4294967296" } }  # 4GB limit per model

# Reduced warmup iterations to save memory during startup
model_warmup [
  {
    name: "warm_batch16_w320"
    batch_size: 16
    count: 1
    inputs {
      key: "x"
      value: {
        data_type: TYPE_FP32
        dims: [ 3, 48, 320 ]
        zero_data: true
      }
    }
  },
  {
    name: "warm_batch8_w160"
    batch_size: 8
    count: 1
    inputs {
      key: "x"
      value: {
        data_type: TYPE_FP32
        dims: [ 3, 48, 160 ]
        zero_data: true
      }
    }
  },
  {
    name: "warm_batch32_w480"
    batch_size: 32
    count: 1
    inputs {
      key: "x"
      value: {
        data_type: TYPE_FP32
        dims: [ 3, 48, 480 ]
        zero_data: true
      }
    }
  }
]
