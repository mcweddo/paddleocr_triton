name: "text_recognition"
backend: "onnxruntime"
max_batch_size : 256
input [
  {
    name: "x"
    data_type: TYPE_FP32
    dims: [ 3, 48, 320 ]
  }
]
output [
  {
    name: "fetch_name_0"
    data_type: TYPE_FP32
    dims: [ -1, 504 ]
  }
]

dynamic_batching {
  preferred_batch_size: [ 16, 32, 64, 128 ]
  max_queue_delay_microseconds: 2000
}

instance_group [
    {
      count: 1
      kind: KIND_GPU
    }
]

#optimization {
#  execution_accelerators {
#    gpu_execution_accelerator: [{
#      name: "tensorrt"
#      parameters { key: "precision_mode" value: "FP16" }
#      parameters { key: "trt_engine_cache_enable" value: "1" }
#      parameters { key: "trt_engine_cache_path"   value: "/workspace/models/_trt_cache/text_recognition" }
#      parameters { key: "trt_cuda_graph_enable"   value: "0"}
#      parameters { key: "max_workspace_size_bytes" value: "4294967296"}
#    }]
#  }
#}

parameters { key: "execution_mode"        value: { string_value: "1" } }
parameters { key: "intra_op_thread_count" value: { string_value: "0" } }
parameters { key: "inter_op_thread_count" value: { string_value: "0" } }

#This keeps idle VRAM from becoming large and spike
parameters { key: "arena_extend_strategy" value: { string_value: "1" } }
#optionally limit max VRAM allocation for model
parameters { key: "gpu_mem_limit"        value: { string_value: "8589934592" } }

# (Optional) Warmup – pick a representative width your pipeline produces
