name: "text_recognition"
backend: "onnxruntime"
max_batch_size : 64
input [
  {
    name: "x"
    data_type: TYPE_FP32
    dims: [ 3, 48, -1 ]
  }
]
output [
  {
    name: "fetch_name_0"
    data_type: TYPE_FP32
    dims: [ -1, 504 ]
  }
]

# Enable dynamic batching to batch text crops together and reduce TensorRT kernel warmups
dynamic_batching {
  preferred_batch_size: [ 4, 8, 16, 32, 64 ]
  max_queue_delay_microseconds: 5000
}

instance_group [
    {
      count: 4
      kind: KIND_GPU
    }
]

optimization {
  execution_accelerators {
    gpu_execution_accelerator: [{
      name: "tensorrt"
      parameters { key: "precision_mode" value: "FP16" }
      parameters { key: "trt_engine_cache_enable" value: "1" }
      parameters { key: "trt_engine_cache_path"   value: "/workspace/models/_trt_cache/text_recognition" }
      parameters { key: "trt_cuda_graph_enable"   value: "0"}
      parameters { key: "max_workspace_size_bytes" value: "4294967296"}
      # Optimization profiles for width dimension (batch handled by max_batch_size)
      parameters { key: "trt_profile_min_shapes" value: "x:3x48x32" }
      parameters { key: "trt_profile_opt_shapes" value: "x:3x48x320" }
      parameters { key: "trt_profile_max_shapes" value: "x:3x48x960" }
    }]
  }
}

parameters { key: "execution_mode"        value: { string_value: "1" } }
parameters { key: "intra_op_thread_count" value: { string_value: "0" } }
parameters { key: "inter_op_thread_count" value: { string_value: "0" } }

# Warmup with multiple width dimensions and batch sizes
model_warmup: [
  {
    name: "warm_batch8_w320"
    batch_size: 8
    count: 2
    inputs: [
      { key: "x" data_type: TYPE_FP32 dims: [ 3, 48, 320 ] zero_data: true }
    ]
  },
  {
    name: "warm_batch16_w320"
    batch_size: 16
    count: 1
    inputs: [
      { key: "x" data_type: TYPE_FP32 dims: [ 3, 48, 320 ] zero_data: true }
    ]
  },
  {
    name: "warm_batch4_w160"
    batch_size: 4
    count: 1
    inputs: [
      { key: "x" data_type: TYPE_FP32 dims: [ 3, 48, 160 ] zero_data: true }
    ]
  },
  {
    name: "warm_batch32_w480"
    batch_size: 32
    count: 1
    inputs: [
      { key: "x" data_type: TYPE_FP32 dims: [ 3, 48, 480 ] zero_data: true }
    ]
  }
]
