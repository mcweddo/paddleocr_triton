name: "text_recognition"
backend: "onnxruntime"
max_batch_size : 0

input [
  {
    name: "x"
    data_type: TYPE_FP32
    dims: [ -1, 3, 48, -1 ]
  }
]
output [
  {
    name: "fetch_name_0"
    data_type: TYPE_FP32
    dims: [ -1, -1, 504 ]
  }
]


instance_group [
    {
      count: 4
      kind: KIND_GPU
    }
]



parameters { key: "execution_mode"        value: { string_value: "1" } }  # 1=Parallel execution
parameters { key: "intra_op_thread_count" value: { string_value: "1" } }
parameters { key: "inter_op_thread_count" value: { string_value: "1" } }

parameters { key: "arena_extend_strategy" value: { string_value: "1" } }
parameters { key: "gpu_mem_limit"         value: { string_value: "3221225472" } }  # 3GB limit (conservative)

# CUDA Execution Provider specific settings
parameters { key: "cudnn_conv_algo_search" value: { string_value: "2" } }
parameters { key: "do_copy_in_default_stream" value: { string_value: "1" } }

parameters { key: "graph_optimization_level" value: { string_value: "2" } }
parameters { key: "enable_mem_pattern" value: { string_value: "1" } }
parameters { key: "enable_cpu_mem_arena" value: { string_value: "1" } }

model_warmup [
  {
    name: "warm_batch16_w320"
    count: 1
    inputs {
      key: "x"
      value: {
        data_type: TYPE_FP32
        dims: [ 16, 3, 48, 320 ]
        zero_data: true
      }
    }
  },
  {
    name: "warm_batch8_w160"
    count: 1
    inputs {
      key: "x"
      value: {
        data_type: TYPE_FP32
        dims: [ 8, 3, 48, 160 ]
        zero_data: true
      }
    }
  },
  {
    name: "warm_batch32_w480"
    count: 1
    inputs {
      key: "x"
      value: {
        data_type: TYPE_FP32
        dims: [ 32, 3, 48, 480 ]
        zero_data: true
      }
    }
  }
]
